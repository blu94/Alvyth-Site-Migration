[
  {
    "ui": { "type": "section", "icon": "tabler-package-import", "cols": 12, "class": "pa-5" },
    "name": "The bundle",
    "subtitle": "Drop the zip the other site produced, then press Read bundle. Nothing is written until you press Import, and Preview will tell you exactly what would change before you do.",
    "elements": [
      {
        "ui": { "type": "row", "dense": false },
        "elements": [
          {
            "ui": {
              "type": "field",
              "cols": 12,
              "props": {
                "maxFiles": 1,
                "maxFilesize": 256,
                "acceptedFiles": ".zip,application/zip,application/x-zip-compressed",
                "usage": "MIGRATION_BUNDLE"
              }
            },
            "key": "bundle",
            "type": "image",
            "label": "Bundle file",
            "hint": "The upload lands in the public folder for a few seconds before this screen moves it somewhere private. Press Read bundle straight away rather than leaving the page open."
          },
          {
            "ui": { "type": "field", "cols": 12, "valueClass": "text-body-2" },
            "key": "inspection",
            "type": "display",
            "label": "What is in it"
          }
        ]
      },
      {
        "ui": { "type": "row", "dense": true },
        "elements": [
          {
            "ui": { "type": "button", "color": "secondary", "variant": "tonal", "icon": "tabler-file-search", "size": "large" },
            "action": "save",
            "endpoint": "/admin/modules/migration-runs/page/import",
            "method": "POST",
            "label": "Read bundle"
          }
        ]
      }
    ]
  },
  {
    "ui": { "type": "section", "icon": "tabler-filter", "cols": 12, "class": "pa-5" },
    "name": "What to bring in",
    "subtitle": "Leave this empty to import everything the bundle carries. Anything you leave out has its data file never opened, so narrowing an import is cheaper, not just smaller.",
    "elements": [
      {
        "ui": { "type": "row", "dense": false },
        "elements": [
          {
            "ui": { "type": "field", "cols": 12, "multiple": true, "chips": true, "closableChips": true },
            "key": "modules",
            "type": "autocomplete",
            "label": "Only these",
            "placeholder": "Everything in the bundle",
            "multiple": true,
            "chips": true,
            "options": { "master": "module_options", "module_options": [] },
            "rules": ["nullable", "array"]
          },
          {
            "ui": { "type": "field", "cols": { "cols": 12, "md": 6 } },
            "key": "on_conflict",
            "type": "select",
            "label": "If a record is already here",
            "default": "skip",
            "options": {
              "items": [
                { "title": "Leave mine alone", "value": "skip" },
                { "title": "Overwrite mine", "value": "overwrite" }
              ]
            },
            "hint": "Overwriting also requires permission to update each resource, not just permission to run a migration."
          }
        ]
      },
      {
        "ui": { "type": "row", "dense": true },
        "elements": [
          {
            "ui": { "type": "button", "color": "info", "variant": "tonal", "icon": "tabler-eye", "size": "large", "cols": 6 },
            "action": "save",
            "endpoint": "/admin/modules/migration-runs/page/import-preview",
            "method": "POST",
            "label": "Preview changes"
          },
          {
            "ui": { "type": "button", "color": "primary", "icon": "tabler-database-import", "size": "large", "cols": 6 },
            "action": "save",
            "endpoint": "/admin/modules/migration-runs/page/import-apply",
            "method": "POST",
            "label": "Import / Continue"
          }
        ]
      }
    ]
  },
  {
    "ui": { "type": "section", "icon": "tabler-progress", "cols": 12, "class": "pa-5" },
    "name": "Progress",
    "subtitle": "A large bundle takes more than one press. If it stops part-way the site is partly populated — press Import again to carry on, do not start over. Re-running is always safe: records are matched on their natural key, so nothing is written twice.",
    "elements": [
      {
        "ui": { "type": "row", "dense": false },
        "elements": [
          {
            "ui": { "type": "field", "cols": 12, "valueClass": "text-body-1" },
            "key": "progress",
            "type": "display",
            "label": "State"
          },
          {
            "ui": { "type": "field", "cols": 12 },
            "key": "preview_text",
            "type": "textarea",
            "label": "What would change",
            "rows": 4,
            "readonly": true,
            "placeholder": "Press Preview to see what this bundle would do."
          },
          {
            "ui": { "type": "field", "cols": 12 },
            "key": "errors_text",
            "type": "textarea",
            "label": "Messages",
            "rows": 5,
            "readonly": true,
            "placeholder": "Nothing to report."
          }
        ]
      }
    ]
  },
  {
    "ui": { "type": "section", "icon": "tabler-shield-check", "cols": 12, "class": "pa-5" },
    "name": "What this will not do",
    "subtitle": "Records are matched on their natural key, never on database id, so importing the same bundle twice updates rather than duplicates.\n\nEvery resource in the bundle is checked against your own permission for it. Being allowed to run a migration is not, on its own, permission to rewrite the catalogue.\n\nNothing secret travels in a bundle: no gateway keys, no SMTP password, no sessions, no audit log.",
    "elements": []
  }
]
