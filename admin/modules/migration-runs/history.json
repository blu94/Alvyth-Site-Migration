[
  {
    "ui": { "type": "section", "icon": "tabler-history", "cols": 12, "class": "pa-5" },
    "name": "Recent runs",
    "subtitle": "Every export and import this site has performed, newest first. Deleting a bundle from the server does not undo the run — the records it wrote stay exactly where they are.",
    "elements": [
      {
        "ui": { "type": "row", "dense": false },
        "elements": [
          {
            "ui": { "type": "field", "cols": 12 },
            "key": "runs_text",
            "type": "textarea",
            "label": "History",
            "rows": 18,
            "readonly": true,
            "placeholder": "No migrations have been run on this site yet."
          },
          {
            "ui": { "type": "field", "cols": 12, "valueClass": "text-body-2" },
            "key": "disk_usage",
            "type": "display",
            "label": "Disk"
          },
          {
            "ui": { "type": "field", "cols": 12, "valueClass": "text-body-2" },
            "key": "storage_at",
            "type": "display",
            "label": "Runs are kept under"
          }
        ]
      }
    ]
  },
  {
    "ui": { "type": "section", "icon": "tabler-trash", "cols": 12, "class": "pa-5" },
    "name": "Remove a run",
    "subtitle": "Deleting a run removes its record and its bundle file from this server. It does not undo anything — every record an import wrote stays exactly where it is.\n\nNothing is removed automatically. A bundle is sometimes the only copy of a site while a migration is in progress, and a tool that quietly deleted one after a month would eventually delete the wrong one.",
    "elements": [
      {
        "ui": { "type": "row", "dense": false },
        "elements": [
          {
            "ui": { "type": "field", "cols": { "cols": 12, "md": 8 } },
            "key": "delete_id",
            "type": "select",
            "label": "Which run",
            "placeholder": "Choose a run",
            "options": { "url": "/admin/modules/migration-runs/options", "master": "runs" },
            "hint": "Listed newest first, with the size of each bundle."
          },
          {
            "ui": { "type": "field", "cols": 12, "valueClass": "text-body-2" },
            "key": "delete_result",
            "type": "display",
            "label": "Result"
          }
        ]
      },
      {
        "ui": { "type": "row", "dense": true },
        "elements": [
          {
            "ui": { "type": "button", "color": "error", "variant": "tonal", "icon": "tabler-trash", "size": "large" },
            "action": "save",
            "endpoint": "/admin/modules/migration-runs/page/history-delete",
            "method": "POST",
            "label": "Remove this run and its bundle"
          }
        ]
      }
    ]
  }
]
